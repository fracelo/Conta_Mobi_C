<Window
    x:Class="ContaMobi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ContaMobi"
    xmlns:controls="using:ContaMobi.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CONTA MOBI // SISTEMA DE GESTAO FINANCEIRA v1.0">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" BorderBrush="#00FF66" BorderThickness="1" Padding="16,10" Margin="0,0,0,12" Background="#030D03">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="[ CONTA MOBI // TERMINAL ]" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtModuloAtual" Text="&gt; MODULO: HOME / DASHBOARD" FontSize="14" Foreground="#00CC55" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPlanoUsuario" Text="PLANO: VERIFICANDO..." FontSize="13" FontWeight="Bold" Foreground="#FFCC00"/>
                    <TextBlock x:Name="TxtDataSistema" Text="DATA: --/--/----" FontSize="13" Foreground="#00CC55"/>
                    <TextBlock Text="STATUS: [ONLINE]" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CORPO: MENU + ÁREA DE CONTEÚDO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MENU LATERAL HIERARQUIZADO -->
            <Border Grid.Column="0" BorderBrush="#00FF66" BorderThickness="1" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
                        <TextBlock Text=":: SISTEMA DE ARQUIVOS ::" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="------------------------" FontSize="11" Foreground="#006622" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">
                            <!-- HOME -->
                            <Button x:Name="BtnNavHome" Content="[F1] HOME / DASHBOARD" Click="MenuButton_Click" Tag="HOME"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32"/>

                            <!-- CADASTROS -->
                            <TextBlock Text="&gt; CADASTROS" FontSize="11" FontWeight="Bold" Foreground="#00AA44" Margin="4,8,0,2"/>
                            <Button Content="  - Bancos" Click="MenuButton_Click" Tag="CAD_BANCOS"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"/>
                            <Button Content="  - Contas Correntes" Click="MenuButton_Click" Tag="CAD_CONTAS"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"/>
                            <Button Content="  - Categorias" Click="MenuButton_Click" Tag="CAD_CATEGORIAS"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"/>
                            <Button Content="  - Entidades" Click="MenuButton_Click" Tag="CAD_ENTIDADES"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"/>
                            <Button Content="  - Bandeiras Cartao" Click="MenuButton_Click" Tag="CAD_BANDEIRAS"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"/>
                            <Button x:Name="BtnNavCartoes" Content="  - Cartoes de Credito" Click="MenuButton_Click" Tag="CAD_CARTOES"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"/>

                            <!-- MOVIMENTO -->
                            <TextBlock Text="&gt; MOVIMENTO" FontSize="11" FontWeight="Bold" Foreground="#00AA44" Margin="4,8,0,2"/>
                            <Button Content="  - Lancamento Contas" Click="MenuButton_Click" Tag="MOV_LANCAMENTOS"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"/>
                            <Button x:Name="BtnNavReceber" Content="  - Contas a Receber" Click="MenuButton_Click" Tag="MOV_RECEBER"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"/>
                            <Button x:Name="BtnNavPagar" Content="  - Contas a Pagar" Click="MenuButton_Click" Tag="MOV_PAGAR"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="30"/>

                            <!-- ORÇAMENTO E FLUXO DE CAIXA -->
                            <TextBlock Text="&gt; PLANEJAMENTO" FontSize="11" FontWeight="Bold" Foreground="#00AA44" Margin="4,8,0,2"/>
                            <Button x:Name="BtnNavOrcamento" Content="[F6] ORCAMENTO" Click="MenuButton_Click" Tag="ORCAMENTO"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32"/>
                            <Button x:Name="BtnNavFluxoCaixa" Content="[F7] FLUXO DE CAIXA" Click="MenuButton_Click" Tag="FLUXO_CAIXA"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RODAPÉ DO MENU -->
                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="------------------------" FontSize="11" Foreground="#006622" HorizontalAlignment="Center"/>
                        <Button x:Name="BtnNavSobre" Content="[F12] SOBRE / PLANO" Click="MenuButton_Click" Tag="SOBRE"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32"/>
                        <Button x:Name="BtnSair" Content="[ESC] ENCERRAR SESSAO" Click="BtnSair_Click"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAINEL CENTRAL DINÂMICO (FRAME) -->
            <Border Grid.Column="1" BorderBrush="#00FF66" BorderThickness="1" Padding="14">
                <Grid>
                    <!-- TELA INICIAL (DASHBOARD COM ROLAGEM) -->
                    <ScrollViewer x:Name="PainelDashboard" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                        <StackPanel Spacing="14" Padding="0,0,8,8">
                            <TextBlock Text="&gt;&gt; RESUMO FINANCEIRO CONSOLIDADO" FontSize="15" FontWeight="Bold"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#00FF66" BorderThickness="1" Padding="14" Background="#051505">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="[ SALDO EM CONTAS ]" FontSize="11" Foreground="#00CC55"/>
                                        <TextBlock x:Name="TxtSaldoTotal" Text="R$ 0,00" FontSize="19" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" BorderBrush="#00FF66" BorderThickness="1" Padding="14" Background="#051505">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="[ RECEITAS MÊS (+)]" FontSize="11" Foreground="#00CC55"/>
                                        <TextBlock x:Name="TxtReceitasMes" Text="R$ 0,00" FontSize="19" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" BorderBrush="#00FF66" BorderThickness="1" Padding="14" Background="#051505">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="[ DESPESAS MÊS (-)]" FontSize="11" Foreground="#00CC55"/>
                                        <TextBlock x:Name="TxtDespesasMes" Text="R$ 0,00" FontSize="19" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" BorderBrush="#3399FF" BorderThickness="1" Padding="14" Background="#09131C">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="[ ORÇAMENTO DO MÊS ]" FontSize="11" Foreground="#3399FF"/>
                                        <TextBlock x:Name="TxtOrcamentoMesResumo" Text="Plan: R$ 0,00&#x0a;Real: R$ 0,00" FontSize="12" FontWeight="Bold" Foreground="#3399FF"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="--------------------------------------------------------------------------------------------------" Foreground="#006622"/>
                            <TextBlock x:Name="TxtStatusBanco" Text="Status do banco..." FontSize="12" Foreground="#00CC55"/>

                            <!-- ========================================================================= -->
                            <!-- 1) SALDO POR CONTA CORRENTE E MÓDULO DO CARTÃO DE CRÉDITO                 -->
                            <!-- ========================================================================= -->
                            <Border Background="#051005" BorderBrush="#3399FF" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,4,0,0">
                                <TextBlock Text="[ DISPONIBILIDADE FINANCEIRA // SALDO POR CONTA E CARTÕES ]"
                                           FontSize="12" FontWeight="Bold" Foreground="#3399FF" />
                            </Border>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- GRÁFICO DE SALDO EM CADA CONTA CORRENTE -->
                                <controls:GraficoPizzaControl x:Name="GraficoSaldoContas" Grid.Column="0" />

                                <!-- ESPAÇO RESERVADO PARA O MÓDULO DE CARTÕES DE CRÉDITO -->
                                <Border x:Name="ContainerGraficoCartoes"
                                        Grid.Column="1"
                                        Background="#030A03"
                                        BorderBrush="#005522"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16"
                                        MinHeight="380">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                        <TextBlock Text="[ CARTÕES DE CRÉDITO // MÓDULO FUTURO ]"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#00CC55"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Espaço reservado para o gráfico de faturas e limites de cartões."
                                                   FontSize="11"
                                                   Foreground="#008844"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="280"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ========================================================================= -->
                            <!-- 2) CONTAS A RECEBER E CONTAS A PAGAR EM ABERTO (PAI -> FILHOS AO CLICAR)   -->
                            <!-- ========================================================================= -->
                            <Border Background="#051005" BorderBrush="#00AA44" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="[ CONTAS A RECEBER E A PAGAR EM ABERTO // POR CATEGORIA ]" FontSize="12" FontWeight="Bold" Foreground="#00FF66" />
                                        <TextBlock x:Name="TxtPeriodoContasPRInfo" Text="Todos os títulos em aberto (clique na fatia pai para ver os filhos)" FontSize="11" Foreground="#00AA44" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="VENCIMENTO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66" />
                                        <ComboBox x:Name="CboPeriodoContasPR" HorizontalAlignment="Stretch" Height="32"
                                                  SelectionChanged="CboPeriodoContasPR_SelectionChanged">
                                            <ComboBoxItem Content="Todos em Aberto" Tag="TODOS" IsSelected="True" />
                                            <ComboBoxItem Content="Esse Mês" Tag="MES_ATUAL" />
                                            <ComboBoxItem Content="Próximos 30 Dias" Tag="PROX_30" />
                                            <ComboBoxItem Content="Atrasados (Vencidos)" Tag="VENCIDOS" />
                                            <ComboBoxItem Content="Personalizado" Tag="PERSONALIZADO" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="VENC. INICIAL:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66" />
                                        <TextBox x:Name="TxtDataIniContasPR" MaxLength="10" PlaceholderText="dd/mm/aaaa" Height="32"
                                                 IsEnabled="False" TextChanged="TxtDataGrafico_TextChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="3">
                                        <TextBlock Text="VENC. FINAL:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66" />
                                        <TextBox x:Name="TxtDataFimContasPR" MaxLength="10" PlaceholderText="dd/mm/aaaa" Height="32"
                                                 IsEnabled="False" TextChanged="TxtDataGrafico_TextChanged" />
                                    </StackPanel>

                                    <Button Grid.Column="4" x:Name="BtnFiltrarContasPR" Content="[FILTRAR]" Click="BtnFiltrarContasPR_Click"
                                            VerticalAlignment="Bottom" Height="32" Padding="14,0"
                                            Style="{StaticResource PrimaryTerminalButtonStyle}" />
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:GraficoPizzaControl x:Name="GraficoContasReceber" Grid.Column="0" />
                                <controls:GraficoPizzaControl x:Name="GraficoContasPagar" Grid.Column="1" />
                            </Grid>

                            <!-- ========================================================================= -->
                            <!-- 3) MOVIMENTAÇÕES EM CONTA CORRENTE (ENTRADAS E SAÍDAS)                    -->
                            <!-- ========================================================================= -->
                            <Border Background="#051005" BorderBrush="#005522" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,6,0,0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="[ MOVIMENTAÇÕES EM CONTA CORRENTE // POR CATEGORIA ]" FontSize="12" FontWeight="Bold" Foreground="#00FF66" />
                                        <TextBlock x:Name="TxtPeriodoGraficoInfo" Text="Período selecionado" FontSize="11" Foreground="#00AA44" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="PERÍODO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66" />
                                        <ComboBox x:Name="CboPeriodoGraficos" HorizontalAlignment="Stretch" Height="32"
                                                  SelectionChanged="CboPeriodoGraficos_SelectionChanged">
                                            <ComboBoxItem Content="Esse Mês" Tag="MES_ATUAL" IsSelected="True" />
                                            <ComboBoxItem Content="Mês Passado" Tag="MES_PASSADO" />
                                            <ComboBoxItem Content="Personalizado" Tag="PERSONALIZADO" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="DATA INICIAL:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66" />
                                        <TextBox x:Name="TxtDataIniGrafico" MaxLength="10" PlaceholderText="dd/mm/aaaa" Height="32"
                                                 IsEnabled="False" TextChanged="TxtDataGrafico_TextChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="3">
                                        <TextBlock Text="DATA FINAL:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66" />
                                        <TextBox x:Name="TxtDataFimGrafico" MaxLength="10" PlaceholderText="dd/mm/aaaa" Height="32"
                                                 IsEnabled="False" TextChanged="TxtDataGrafico_TextChanged" />
                                    </StackPanel>

                                    <Button Grid.Column="4" x:Name="BtnFiltrarGraficos" Content="[FILTRAR]" Click="BtnFiltrarGraficos_Click"
                                            VerticalAlignment="Bottom" Height="32" Padding="14,0"
                                            Style="{StaticResource PrimaryTerminalButtonStyle}" />
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:GraficoPizzaControl x:Name="GraficoEntradas" Grid.Column="0" />
                                <controls:GraficoPizzaControl x:Name="GraficoSaidas" Grid.Column="1" />
                            </Grid>

                            <!-- ========================================================================= -->
                            <!-- 4) ORÇAMENTO PLANEJADO (ANO CORRENTE - RECEITAS E DESPESAS)               -->
                            <!-- ========================================================================= -->
                            <Border Background="#051005" BorderBrush="#FFCC00" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,6,0,0">
                                <TextBlock x:Name="TxtTituloOrcamentoPlanejadoAno"
                                           Text="[ ORÇAMENTO PLANEJADO // ANO CORRENTE ]"
                                           FontSize="12" FontWeight="Bold" Foreground="#FFCC00" />
                            </Border>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <controls:GraficoPizzaControl x:Name="GraficoOrcamentoPlanejadoReceitas" Grid.Column="0" />
                                <controls:GraficoPizzaControl x:Name="GraficoOrcamentoPlanejadoDespesas" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- FRAME DE NAVEGAÇÃO PARA CARREGAR AS PÁGINAS -->
                    <Frame x:Name="MainContentFrame" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- RODAPÉ -->
        <Border Grid.Row="2" BorderBrush="#00FF66" BorderThickness="1" Padding="10,4" Margin="0,10,0,0" Background="#030D03">
            <Grid>
                <TextBlock Text="STATUS: PRONTO  |  DB: SQLITE LOCAL  |  NAVEGACAO: MENU LATERAL" FontSize="11" Foreground="#00CC55"/>
                <TextBlock Text="CONTA MOBI v1.0" FontSize="11" Foreground="#006622" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>