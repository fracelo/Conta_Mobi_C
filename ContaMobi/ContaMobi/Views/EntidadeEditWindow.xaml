<Window
    x:Class="ContaMobi.Views.EntidadeEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ContaMobi.Models"
    mc:Ignorable="d"
    Title="CONTA MOBI // ENTIDADE">

    <Grid Background="#000000" Padding="16">
        <Border BorderBrush="#00FF66" BorderThickness="1" Background="#030A03" Padding="16">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock x:Name="TxtTitulo" Text="[ CADASTRO DE ENTIDADE // DADOS &amp; CONTATOS ]" FontSize="14" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="------------------------------------------------------------------------------------------------" FontSize="11" Foreground="#006622"/>
                </StackPanel>

                <!-- MENSAGEM DE ERRO / STATUS -->
                <TextBlock Grid.Row="1" x:Name="TxtMensagem" FontSize="11" Foreground="#FF5555" TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- BLOCO 1: DADOS PRINCIPAIS EM LINHAS INDEPENDENTES -->
                <StackPanel Grid.Row="2" Spacing="8">

                    <!-- LINHA 1: CLASSIFICAÇÃO E TIPO DE PESSOA -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="CLASSIFICACAO (*):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <ComboBox x:Name="CboTipoEntidade" HorizontalAlignment="Stretch" Height="32">
                                <ComboBoxItem Content="Cliente" IsSelected="True"/>
                                <ComboBoxItem Content="Fornecedor"/>
                                <ComboBoxItem Content="Parceiro"/>
                                <ComboBoxItem Content="Funcionario"/>
                                <ComboBoxItem Content="Outros"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="TIPO DE PESSOA (*):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <StackPanel Orientation="Horizontal" Spacing="16" Height="32" VerticalAlignment="Center">
                                <RadioButton x:Name="RbFisica" Content="PESSOA FISICA (PF)" IsChecked="True" Checked="RbPessoa_Changed" Foreground="#00FF66"/>
                                <RadioButton x:Name="RbJuridica" Content="PESSOA JURIDICA (PJ)" Checked="RbPessoa_Changed" Foreground="#55CC77"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- LINHA 2: NOME COMPLETO / RAZÃO SOCIAL -->
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="LblNomeRazao" Text="NOME COMPLETO (*):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <TextBox x:Name="TxtNomeRazao" PlaceholderText="Informe o nome completo ou razao social..." Height="32"/>
                    </StackPanel>

                    <!-- LINHA 3: DOCUMENTOS (CPF/CNPJ E RG/IE) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock x:Name="LblCpfCnpj" Text="CPF:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtCpfCnpj" PlaceholderText="Documento principal" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock x:Name="LblRgIe" Text="RG:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtRgIe" PlaceholderText="RG ou Inscricao Estadual" Height="32"/>
                        </StackPanel>
                    </Grid>

                    <!-- LINHA 4: CEP, CIDADE E UF -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="CEP:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtCep" MaxLength="9" PlaceholderText="00000-000" Height="32" KeyDown="TxtCep_KeyDown"/>
                        </StackPanel>

                        <Button Grid.Column="1" x:Name="BtnBuscarCep" Content="[BUSCAR CEP]" Click="BtnBuscarCep_Click"
                                VerticalAlignment="Bottom" Height="32" FontSize="10" Padding="10,0"/>

                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="CIDADE:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtCidade" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="3">
                            <TextBlock Text="UF:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtUf" MaxLength="2" Height="32"/>
                        </StackPanel>
                    </Grid>

                    <!-- LINHA 5: ENDEREÇO (LOGRADOURO, NÚMERO, BAIRRO E COMPLEMENTO) -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="LOGRADOURO (RUA / AV):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtLogradouro" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="NUMERO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtNumero" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="BAIRRO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtBairro" Height="32"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="3">
                            <TextBlock Text="COMPLEMENTO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtComplemento" Height="32"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- BLOCO 2: GRID / LISTA DE CONTATOS VINCULADOS -->
                <Border Grid.Row="3" BorderBrush="#005522" BorderThickness="1" Background="#020802" Padding="8">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="[ CANAIS DE CONTATO / TELEFONES / REDES ]" FontSize="11" FontWeight="Bold" Foreground="#00FF66" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="BtnAdicionarContato" Content="[+] NOVO CONTATO" Click="BtnAdicionarContato_Click"
                                    Height="28" FontSize="11" Style="{StaticResource PrimaryTerminalButtonStyle}"/>
                        </Grid>

                        <ListView Grid.Row="1" x:Name="ListaContatos" SelectionMode="Single" DoubleTapped="ListaContatos_DoubleTapped">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Background="#051A05" Padding="6,4" BorderBrush="#008833" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="NOME / SETOR" Foreground="#00FF66" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="CANAIS DISPONIVEIS" Foreground="#00FF66" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock Grid.Column="2" Text="ACOES" Foreground="#00FF66" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Contato">
                                    <Grid Padding="6,4" BorderBrush="#002208" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind NomeDescricao}" Foreground="#00FF66" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind ResumoCanais}" Foreground="#55CC77" FontSize="11" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="[X]" Click="BtnRemoverContato_Click" 
                                                Foreground="#FF5555" Background="Transparent" BorderThickness="0" 
                                                Padding="4,2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- FORMULÁRIO DE ENTRADA RÁPIDA DE CONTATO -->
                        <Border Grid.Row="2" x:Name="PainelNovoContato" BorderBrush="#006622" BorderThickness="1" Background="#041204" Padding="8" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="NOME/IDENTIFICACAO (*):" FontSize="10" Foreground="#00FF66"/>
                                        <TextBox x:Name="TxtContatoNome" PlaceholderText="Ex: Comercial, Financeiro, Joao" Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="WHATSAPP:" FontSize="10" Foreground="#00FF66"/>
                                        <TextBox x:Name="TxtContatoWhats" Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="TELEFONE FIXO:" FontSize="10" Foreground="#00FF66"/>
                                        <TextBox x:Name="TxtContatoFone" Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="2">
                                        <TextBlock Text="E-MAIL:" FontSize="10" Foreground="#00FF66"/>
                                        <TextBox x:Name="TxtContatoEmail" Height="30"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="TELEGRAM (@):" FontSize="10" Foreground="#00FF66"/>
                                        <TextBox x:Name="TxtContatoTelegram" Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="INSTAGRAM (@):" FontSize="10" Foreground="#00FF66"/>
                                        <TextBox x:Name="TxtContatoInstagram" Height="30"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="[+] SALVAR CONTATO" Click="BtnConfirmarContato_Click" 
                                            VerticalAlignment="Bottom" Height="30" Style="{StaticResource PrimaryTerminalButtonStyle}"/>
                                    <Button Grid.Column="3" Content="CANCELAR" Click="BtnCancelarContato_Click" 
                                            VerticalAlignment="Bottom" Height="30"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- BLOCO 3: BOTÕES DE GRAVAÇÃO DA ENTIDADE -->
                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSalvar" Content="[F10] GRAVAR ENTIDADE COMPLETA" Click="BtnSalvar_Click"
                            Style="{StaticResource PrimaryTerminalButtonStyle}" Height="36" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" x:Name="BtnCancelar" Content="[ESC] FECHAR" Click="BtnCancelar_Click"
                            Height="36" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="2" x:Name="BtnExcluir" Content="[DEL] EXCLUIR" Click="BtnExcluir_Click"
                            Background="#330000" Foreground="#FF5555" BorderBrush="#880000" Height="36" Width="100" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>