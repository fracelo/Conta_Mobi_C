<Page
    x:Class="ContaMobi.Views.BandeirasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ContaMobi.Views"
    xmlns:models="using:ContaMobi.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PRIMEIRA LINHA: CAMPO DE BUSCA + BOTÃO INSERIR -->
        <Grid Grid.Row="0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtBusca" Grid.Column="0" PlaceholderText="Buscar por descricao da bandeira..."
                     Height="36" TextChanged="TxtBusca_TextChanged"/>

            <Button x:Name="BtnBuscar" Grid.Column="1" Content="[BUSCAR]" Click="BtnBuscar_Click" Width="90" Height="36"/>

            <Button x:Name="BtnInserir" Grid.Column="2" Content="[+] INSERIR BANDEIRA" Click="BtnInserir_Click"
                    Style="{StaticResource PrimaryTerminalButtonStyle}" Height="36" Padding="14,0"/>
        </Grid>

        <!-- LISTA / TABELA COM ESTILO RETRÔ DE TERMINAL -->
        <Border Grid.Row="1" BorderBrush="#008833" BorderThickness="1" Background="#020802">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#008833" BorderThickness="0,0,0,1" Background="#051505" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ICONE" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="DESCRICAO DA BANDEIRA" FontWeight="Bold" Foreground="#00FF66"/>
                        <TextBlock Grid.Column="2" Text="STATUS" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="ACOES" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <ListView x:Name="ListaBandeiras" Grid.Row="1" SelectionMode="Single"
                          DoubleTapped="ListaBandeiras_DoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Bandeira">
                            <Grid Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="26" CornerRadius="3"
                                    Background="#FFFFFF" BorderBrush="#008833" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2">
                                    <Image Source="{x:Bind IconeSource}" Stretch="Uniform"/>
                                </Border>

                                <TextBlock Grid.Column="1" Text="{x:Bind DescricaoBandeira}" Foreground="#55CC77" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind StatusTexto}" Foreground="{x:Bind StatusCor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Column="3"
                                        Content="[EDITAR]"
                                        Click="BtnEditarLinha_Click"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Height="28"
                                        Padding="10,0"
                                        FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="&gt; Dica: Clique em [EDITAR] ou de duplo clique na linha para alterar o nome ou o icone da bandeira."
                   FontSize="11" Foreground="#00AA44"/>
    </Grid>
</Page>