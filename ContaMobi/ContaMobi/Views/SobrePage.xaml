<Page
    x:Class="ContaMobi.Views.SobrePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#000000" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" BorderBrush="#00FF66" BorderThickness="1" Background="#051005" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="[ SISTEMA // SOBRE O CONTA MOBI &amp; ASSINATURA ]" FontSize="16" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="INFORMACOES DO PLANO ATIVO, CANAIS DE AJUDA/SUPORTE E DADOS DO DESENVOLVEDOR" FontSize="11" Foreground="#00AA44"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="VERSAO 1.0.0" FontSize="12" FontWeight="Bold" Foreground="#00FF66" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- CONTEÚDO PRINCIPAL ROLÁVEL -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Padding="0,0,8,8">

                <!-- BLOCO 1: PLANO ATUAL E ASSINATURA -->
                <Border BorderBrush="#FFCC00" BorderThickness="1" Background="#071005" Padding="16">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="[ SUA ASSINATURA E PLANO ATUAL ]" FontSize="13" FontWeight="Bold" Foreground="#FFCC00"/>
                                <TextBlock x:Name="TxtUsuarioTitular" Text="Titular: -" FontSize="12" Foreground="#88CC99"/>
                            </StackPanel>

                            <Border x:Name="BadgeStatusPlano" Grid.Column="1" BorderBrush="#00FF66" BorderThickness="1" Background="#051F05" Padding="12,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatusPlano" Text="ATIVO" FontSize="11" FontWeight="Bold" Foreground="#00FF66"/>
                            </Border>
                        </Grid>

                        <!-- CARDS DE DETALHES DO PLANO -->
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.0*"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#005522" BorderThickness="1" Background="#030A03" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PLANO ATIVO" FontSize="10" Foreground="#00AA44"/>
                                    <TextBlock x:Name="TxtNomePlano" Text="Plano Grátis" FontSize="17" FontWeight="Bold" Foreground="#FFCC00"/>
                                    <TextBlock x:Name="TxtValorPlano" Text="R$ 0,00 / mês" FontSize="11" Foreground="#88CC99"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" BorderBrush="#005522" BorderThickness="1" Background="#030A03" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="CICLO DE COBRANÇA" FontSize="10" Foreground="#00AA44"/>
                                    <TextBlock x:Name="TxtCicloPlano" Text="GRÁTIS" FontSize="15" FontWeight="Bold" Foreground="#00FF66"/>
                                    <TextBlock Text="Renovação via Web" FontSize="11" Foreground="#669977"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderBrush="#005522" BorderThickness="1" Background="#030A03" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="VALIDADE / VENCIMENTO" FontSize="10" Foreground="#00AA44"/>
                                    <TextBlock x:Name="TxtVencimentoPlano" Text="Sem vencimento" FontSize="15" FontWeight="Bold" Foreground="#00FF66"/>
                                    <TextBlock x:Name="TxtAvisoVencimento" Text="Acesso regular" FontSize="11" Foreground="#669977"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" BorderBrush="#005522" BorderThickness="1" Background="#030A03" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="RECURSOS DO PLANO" FontSize="10" Foreground="#00AA44"/>
                                    <TextBlock x:Name="TxtRecursosPlano"
                                               Text="• Contas Correntes: 1&#x0a;• Cartões de Crédito: Bloqueado&#x0a;• Orçamento / Fluxo: Bloqueado"
                                               FontSize="11"
                                               Foreground="#88CC99"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- AÇÕES DE ASSINATURA (MUDAR DE PLANO + SINCRONIZAR) -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button x:Name="BtnMudarPlano"
                                        Content="[ MUDAR DE PLANO / FAZER UPGRADE ]"
                                        Click="BtnMudarPlano_Click"
                                        Background="#003319"
                                        Foreground="#00FF66"
                                        BorderBrush="#00FF66"
                                        BorderThickness="1"
                                        FontWeight="Bold"
                                        Height="36"
                                        Padding="16,0"/>

                                <Button x:Name="BtnAtualizarPlano"
                                        Content="[ SINCRONIZAR ASSINATURA ]"
                                        Click="BtnAtualizarPlano_Click"
                                        Background="#051505"
                                        Foreground="#00CC55"
                                        BorderBrush="#006622"
                                        BorderThickness="1"
                                        FontWeight="SemiBold"
                                        Height="36"
                                        Padding="14,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       x:Name="TxtStatusSyncPlano"
                                       Text=""
                                       FontSize="11"
                                       Foreground="#00FF66"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- BLOCO 2: AJUDA/SUPORTE E DADOS DO DESENVOLVEDOR -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- COLUNA ESQUERDA: AJUDA E SUPORTE -->
                    <Border Grid.Column="0" BorderBrush="#3399FF" BorderThickness="1" Background="#040D14" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="[ AJUDA &amp; SUPORTE TÉCNICO ]" FontSize="13" FontWeight="Bold" Foreground="#3399FF"/>
                            <TextBlock Text="Precisa de ajuda com lançamentos, conciliação, cartões ou cobrança? Acesse nossa central online ou fale direto com o suporte:"
                                       FontSize="12"
                                       Foreground="#99C2FF"
                                       TextWrapping="Wrap"/>

                            <Border Height="1" Background="#113355" Margin="0,2"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="CENTRAL DE AJUDA E TUTORIAIS:" FontSize="10" FontWeight="Bold" Foreground="#3399FF"/>
                                <HyperlinkButton x:Name="LnkAjudaOnline"
                                                 Content="https://contamobi.vercel.app/#ajuda"
                                                 Click="BtnAjuda_Click"
                                                 Foreground="#00FF66"
                                                 Padding="0"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="E-MAIL DE SUPORTE:" FontSize="10" FontWeight="Bold" Foreground="#3399FF"/>
                                <HyperlinkButton x:Name="LnkEmailSuporte"
                                                 Content="suporte@contamobi.com.br"
                                                 Click="BtnSuporteEmail_Click"
                                                 Foreground="#00FF66"
                                                 Padding="0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <Button x:Name="BtnAbrirAjuda"
                                        Content="[ ABRIR CENTRAL DE AJUDA ]"
                                        Click="BtnAjuda_Click"
                                        Background="#081C30"
                                        Foreground="#3399FF"
                                        BorderBrush="#3399FF"
                                        BorderThickness="1"
                                        FontWeight="Bold"
                                        Height="34"
                                        Padding="14,0"/>

                                <Button x:Name="BtnCopiarDiagnostico"
                                        Content="[ COPIAR DADOS P/ SUPORTE ]"
                                        Click="BtnCopiarDiagnostico_Click"
                                        Background="#051505"
                                        Foreground="#00CC55"
                                        BorderBrush="#006622"
                                        BorderThickness="1"
                                        Height="34"
                                        Padding="12,0"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtFeedbackCopia"
                                       Text=""
                                       FontSize="11"
                                       Foreground="#00FF66"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- COLUNA DIREITA: DADOS DO DESENVOLVEDOR -->
                    <Border Grid.Column="1" BorderBrush="#00FF66" BorderThickness="1" Background="#030A03" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="[ DADOS DO DESENVOLVEDOR ]" FontSize="13" FontWeight="Bold" Foreground="#00FF66"/>
                            <TextBlock Text="Software desenvolvido para controle financeiro pessoal e empresarial com armazenamento local SQLite e sincronização em nuvem."
                                       FontSize="12"
                                       Foreground="#88CC99"
                                       TextWrapping="Wrap"/>

                            <Border Height="1" Background="#004411" Margin="0,2"/>

                            <Grid RowSpacing="6" ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="SISTEMA:" FontSize="11" FontWeight="Bold" Foreground="#00AA44"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Conta Mobi — Gestão Financeira" FontSize="12" Foreground="#00FF66"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="DESENVOLVEDOR:" FontSize="11" FontWeight="Bold" Foreground="#00AA44"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="House Franzoi" FontSize="12" Foreground="#88CC99"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="EMPRESA:" FontSize="11" FontWeight="Bold" Foreground="#00AA44"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="House Franzoi — Maringá, PR" FontSize="12" Foreground="#88CC99"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="PLATAFORMA:" FontSize="11" FontWeight="Bold" Foreground="#00AA44"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Windows 10 / 11 (64-bit) • WinUI 3" FontSize="12" Foreground="#88CC99"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="PORTAL WEB:" FontSize="11" FontWeight="Bold" Foreground="#00AA44"/>
                                <HyperlinkButton Grid.Row="4" Grid.Column="1"
                                                 x:Name="LnkSiteOficial"
                                                 Content="https://contamobi.vercel.app"
                                                 Click="BtnSiteOficial_Click"
                                                 Foreground="#00FF66"
                                                 Padding="0"/>
                            </Grid>

                            <TextBlock Text="© 2026 Conta Mobi — Todos os direitos reservados."
                                       FontSize="11"
                                       Foreground="#006622"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- RODAPÉ -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="&gt; DICA: APOS ALTERAR SEU PLANO NO PORTAL WEB, CLIQUE EM [SINCRONIZAR ASSINATURA] PARA ATUALIZAR NA HORA."
                       FontSize="11"
                       Foreground="#00AA44"/>
        </Grid>
    </Grid>
</Page>