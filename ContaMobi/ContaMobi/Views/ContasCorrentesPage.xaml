<Page
    x:Class="ContaMobi.Views.ContasCorrentesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ContaMobi.Models"
    mc:Ignorable="d">

    <Grid Background="#000000" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" BorderBrush="#00FF66" BorderThickness="1" Background="#051005" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="[ CADASTRO // CONTAS CORRENTES ]" FontSize="16" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="GERENCIE SUAS CONTAS BANCARIAS E SALDOS INICIAIS" FontSize="11" Foreground="#00AA44"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnInserir" Content="[+] NOVA CONTA (F2)" Click="BtnInserir_Click"
                        Style="{StaticResource PrimaryTerminalButtonStyle}" Height="34" Width="170"/>
            </Grid>
        </Border>

        <!-- BARRA DE BUSCA -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtBusca" Grid.Column="0" PlaceholderText="BUSCAR POR CONTA, DESCRICAO OU BANCO..." 
                     Height="34" Margin="0,0,8,0" TextChanged="TxtBusca_TextChanged" KeyDown="TxtBusca_KeyDown"/>

            <Button Grid.Column="1" x:Name="BtnBuscar" Content="[F3] FILTRAR" Click="BtnBuscar_Click" 
                    Height="34" Width="120"/>
        </Grid>

        <!-- LISTA TABULAR COM CABEÇALHO -->
        <Border Grid.Row="2" BorderBrush="#004411" BorderThickness="1" Background="#020802">
            <ListView x:Name="ListaContas" 
                      DoubleTapped="ListaContas_DoubleTapped" 
                      KeyDown="ListaContas_KeyDown"
                      SelectionMode="Single">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Background="#051A05" Padding="10,8" BorderBrush="#008833" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DESCRICAO DA CONTA" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="INSTITUICAO BANCARIA" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="DATA ABERTURA" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="SALDO INICIAL" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ContaCorrente">
                        <Grid Padding="10,8" BorderBrush="#003311" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Descricao}" Foreground="#00FF66" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind BancoFormatado}" Foreground="#55CC77" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind DataCriacaoFormatada}" Foreground="#00AA44" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind SaldoFormatado}" Foreground="{x:Bind SaldoCor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- RODAPÉ DE STATUS E ATALHOS -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&gt; [ENTER] / [DUPLO CLIQUE]: EDITAR | [F2]: NOVA CONTA" FontSize="11" Foreground="#00AA44"/>
                <TextBlock Grid.Column="1" x:Name="TxtTotalRegistros" Text="REGISTROS: 0" FontSize="11" Foreground="#00FF66" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Page>