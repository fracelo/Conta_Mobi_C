<Page
    x:Class="ContaMobi.Views.FluxoCaixaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:ContaMobi.Data"
    mc:Ignorable="d">

    <Grid Background="#000000" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO E SELETOR DE VISÃO (DIÁRIO / SEMANAL / MENSAL) -->
        <Border Grid.Row="0" BorderBrush="#00FF66" BorderThickness="1" Background="#051005" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="[ PLANEJAMENTO // FLUXO DE CAIXA PROJETADO (A PARTIR DE HOJE) ]" FontSize="16" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock x:Name="TxtSubtituloFluxo" Text="VISAO DIARIA: SALDO EM CONTAS + A RECEBER (INCL. ATRASADOS) - A PAGAR (INCL. ATRASADOS)"
                               FontSize="11" Foreground="#00AA44"/>
                </StackPanel>

                <!-- BOTÕES DE AGRUPAMENTO -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="BtnVisaoDiaria" Content="[ DIARIO ]" Click="BtnAgrupamento_Click" Tag="DIARIO"
                            Height="34" Padding="14,0" FontWeight="Bold"
                            Style="{StaticResource PrimaryTerminalButtonStyle}"/>

                    <Button x:Name="BtnVisaoSemanal" Content="[ SEMANAL ]" Click="BtnAgrupamento_Click" Tag="SEMANAL"
                            Height="34" Padding="14,0" FontWeight="Bold"
                            Background="#051505" Foreground="#00AA44" BorderBrush="#006622" BorderThickness="1"/>

                    <Button x:Name="BtnVisaoMensal" Content="[ MENSAL ]" Click="BtnAgrupamento_Click" Tag="MENSAL"
                            Height="34" Padding="14,0" FontWeight="Bold"
                            Background="#051505" Foreground="#00AA44" BorderBrush="#006622" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRA DE FILTROS -->
        <Border Grid.Row="1" BorderBrush="#004411" BorderThickness="1" Background="#030A03" Padding="10" Margin="0,0,0,8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.9*"/>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="CONTA CORRENTE:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <ComboBox x:Name="CboFiltroConta" HorizontalAlignment="Stretch" Height="32" SelectionChanged="Filtro_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="HORIZONTE DE PROJECAO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <ComboBox x:Name="CboFiltroPeriodo" HorizontalAlignment="Stretch" Height="32" SelectionChanged="CboFiltroPeriodo_SelectionChanged">
                            <ComboBoxItem Content="Restante desse Mes (Hoje ao fim do mes)" Tag="MES" IsSelected="True"/>
                            <ComboBoxItem Content="Proximos 15 Dias" Tag="15_DIAS"/>
                            <ComboBoxItem Content="Proximos 30 Dias" Tag="30_DIAS"/>
                            <ComboBoxItem Content="Proximos 90 Dias" Tag="90_DIAS"/>
                            <ComboBoxItem Content="Restante desse Ano (Hoje a Dez)" Tag="ANO"/>
                            <ComboBoxItem Content="Personalizado (a partir de Hoje)" Tag="PERSONALIZADO"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="DATA INICIAL:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <TextBox x:Name="TxtDataInicio" MaxLength="10" PlaceholderText="dd/mm/aaaa" Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="3">
                        <TextBlock Text="DATA FINAL:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <TextBox x:Name="TxtDataFim" MaxLength="10" PlaceholderText="dd/mm/aaaa" Height="32"/>
                    </StackPanel>

                    <Button Grid.Column="4" x:Name="BtnGerarFluxo" Content="[F3] GERAR FLUXO" Click="BtnGerarFluxo_Click"
                            Style="{StaticResource PrimaryTerminalButtonStyle}"
                            VerticalAlignment="Bottom" Height="32" Padding="14,0"/>
                </Grid>

                <!-- OPÇÕES COMPLEMENTARES -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24">
                    <CheckBox x:Name="ChkIncluirAtrasados"
                              Content="Incluir atrasados em aberto (Receber e Pagar vencidos antes de hoje)"
                              IsChecked="True"
                              Foreground="#00CC55"
                              FontSize="11"
                              Checked="OpcaoCheck_Changed"
                              Unchecked="OpcaoCheck_Changed"/>

                    <CheckBox x:Name="ChkOcultarSemMovimento"
                              Content="Ocultar dias/periodos sem movimentacao"
                              IsChecked="False"
                              Foreground="#00CC55"
                              FontSize="11"
                              Checked="OpcaoCheck_Changed"
                              Unchecked="OpcaoCheck_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4 CARDS RESUMO CONSOLIDADOS -->
        <Grid Grid.Row="2" ColumnSpacing="10" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CARD 1: SALDO DAS CONTAS -->
            <Border Grid.Column="0" BorderBrush="#00FF66" BorderThickness="1" Background="#051505" Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="[ SALDO DAS CONTAS HOJE ]" FontSize="10" FontWeight="Bold" Foreground="#00CC55"/>
                    <TextBlock x:Name="TxtCardSaldoContas" Text="R$ 0,00" FontSize="17" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="Saldo realizado em banco ate hoje" FontSize="10" Foreground="#008844"/>
                </StackPanel>
            </Border>

            <!-- CARD 2: TOTAL A RECEBER -->
            <Border Grid.Column="1" BorderBrush="#3399FF" BorderThickness="1" Background="#081420" Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="[ (+) TOTAL A RECEBER ]" FontSize="10" FontWeight="Bold" Foreground="#3399FF"/>
                    <TextBlock x:Name="TxtCardTotalReceber" Text="R$ 0,00" FontSize="17" FontWeight="Bold" Foreground="#3399FF"/>
                    <TextBlock x:Name="TxtCardDetalheReceber" Text="Atrasados: R$ 0,00 | Periodo: R$ 0,00" FontSize="10" Foreground="#77B5FE"/>
                </StackPanel>
            </Border>

            <!-- CARD 3: TOTAL A PAGAR -->
            <Border Grid.Column="2" BorderBrush="#FF5555" BorderThickness="1" Background="#1C0808" Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="[ (-) TOTAL A PAGAR ]" FontSize="10" FontWeight="Bold" Foreground="#FF5555"/>
                    <TextBlock x:Name="TxtCardTotalPagar" Text="R$ 0,00" FontSize="17" FontWeight="Bold" Foreground="#FF5555"/>
                    <TextBlock x:Name="TxtCardDetalhePagar" Text="Atrasados: R$ 0,00 | Periodo: R$ 0,00" FontSize="10" Foreground="#FF9999"/>
                </StackPanel>
            </Border>

            <!-- CARD 4: SALDO FINAL PROJETADO -->
            <Border Grid.Column="3" BorderBrush="#00FF66" BorderThickness="2" Background="#061D06" Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="[ (=) SALDO FINAL PROJETADO ]" FontSize="10" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock x:Name="TxtCardSaldoFinal" Text="R$ 0,00" FontSize="18" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="Contas + Receber - Pagar" FontSize="10" Foreground="#00AA44"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TABELA DO FLUXO DE CAIXA (CABEÇALHO FIXO + LISTA ROLÁVEL) -->
        <Border Grid.Row="3" BorderBrush="#004411" BorderThickness="1" Background="#020802">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- CABEÇALHO FIXO -->
                <Grid Grid.Row="0" Background="#051A05" Padding="12,8" BorderBrush="#008833" BorderThickness="0,0,0,1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="175"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="88"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PERIODO / DATA" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="TITULOS" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="2" Text="SALDO ANTERIOR" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="(+) A RECEBER" Foreground="#3399FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="(-) A PAGAR" Foreground="#FF5555" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="RESULTADO" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="SALDO FINAL" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="DETALHES" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                </Grid>

                <!-- LINHAS ROLÁVEIS -->
                <ListView Grid.Row="1" x:Name="ListaFluxoCaixa" SelectionMode="Single"
                          DoubleTapped="ListaFluxoCaixa_DoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="data:FluxoCaixaLinha">
                            <Grid Padding="12,7" BorderBrush="#00280A" BorderThickness="0,0,0,1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.7*"/>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="88"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind PeriodoLabel}">
                                    <TextBlock Text="{x:Bind PeriodoLabel}" Foreground="{x:Bind PeriodoCor}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind SubtituloPeriodo}" Foreground="#007733" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{x:Bind QtdResumo}" Foreground="#88CC99" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind SaldoAnteriorFormatado}" Foreground="{x:Bind SaldoAnteriorCor}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind TotalReceberFormatado}" Foreground="{x:Bind TotalReceberCor}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind TotalPagarFormatado}" Foreground="{x:Bind TotalPagarCor}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind ResultadoPeriodoFormatado}" Foreground="{x:Bind ResultadoPeriodoCor}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{x:Bind SaldoFinalFormatado}" Foreground="{x:Bind SaldoFinalCor}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <Button Grid.Column="7"
                                        Content="TITULOS"
                                        Tag="{x:Bind}"
                                        Click="BtnVerTitulos_Click"
                                        Background="#051805"
                                        Foreground="#00FF66"
                                        BorderBrush="#00AA44"
                                        BorderThickness="1"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Height="26"
                                        Padding="10,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- RODAPÉ -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="&gt; [DUPLO CLIQUE / TITULOS]: DETALHAR CONTAS A PAGAR E RECEBER DA LINHA"
                       FontSize="11" Foreground="#00AA44" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" x:Name="TxtResumoLinhas" Text="LINHAS EXIBIDAS: 0"
                       FontSize="11" Foreground="#00FF66" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>