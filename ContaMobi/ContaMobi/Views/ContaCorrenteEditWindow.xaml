<Window
    x:Class="ContaMobi.Views.ContaCorrenteEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CONTA MOBI // CONTA CORRENTE">

    <Grid Background="#000000" Padding="20">
        <Border BorderBrush="#00FF66" BorderThickness="1" Background="#030A03" Padding="20" VerticalAlignment="Center">
            <StackPanel Spacing="14">

                <!-- TÍTULO -->
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TxtTitulo" Text="[ NOVO CADASTRO DE CONTA CORRENTE ]" FontSize="14" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="--------------------------------------------------" FontSize="11" Foreground="#006622"/>
                </StackPanel>

                <!-- FEEDBACK ERRO -->
                <TextBlock x:Name="TxtMensagem" FontSize="11" Foreground="#FF5555" TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- DESCRICAO -->
                <StackPanel Spacing="4">
                    <TextBlock Text="DESCRICAO / APELIDO DA CONTA (*):" FontSize="11" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <TextBox x:Name="TxtDescricao" PlaceholderText="Ex: Banco do Brasil - Principal, Nubank PJ" Height="36"/>
                </StackPanel>

                <!-- BANCO -->
                <StackPanel Spacing="4">
                    <TextBlock Text="INSTITUICAO BANCARIA (*):" FontSize="11" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <ComboBox x:Name="CboBanco" HorizontalAlignment="Stretch" Height="36" PlaceholderText="Selecione o banco..."/>
                </StackPanel>

                <!-- GRID: DATA E SALDO INICIAL -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="DATA DE ABERTURA:" FontSize="11" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <CalendarDatePicker x:Name="DpDataCriacao" HorizontalAlignment="Stretch" Height="36" DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="SALDO INICIAL (R$):" FontSize="11" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <TextBox x:Name="TxtSaldoInicial" Text="0,00" Height="36"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="--------------------------------------------------" FontSize="11" Foreground="#006622"/>

                <!-- BOTÕES DE AÇÃO -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSalvar" Content="[F10] GRAVAR" Click="BtnSalvar_Click"
                            Style="{StaticResource PrimaryTerminalButtonStyle}" Height="36" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" x:Name="BtnCancelar" Content="[ESC] FECHAR" Click="BtnCancelar_Click"
                            Height="36" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="2" x:Name="BtnExcluir" Content="[DEL] EXCLUIR" Click="BtnExcluir_Click"
                            Background="#330000" Foreground="#FF5555" BorderBrush="#880000" Height="36" Width="100" Visibility="Collapsed"/>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>