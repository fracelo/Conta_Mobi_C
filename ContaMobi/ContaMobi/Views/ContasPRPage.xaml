<Page
    x:Class="ContaMobi.Views.ContasPRPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ContaMobi.Models"
    mc:Ignorable="d">

    <Grid Background="#000000" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO DINÂMICO -->
        <Border Grid.Row="0" BorderBrush="#00FF66" BorderThickness="1" Background="#051005" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtTituloPagina" Text="[ CONTAS A PAGAR // GESTAO DE TITULOS ]" FontSize="16" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock x:Name="TxtSubtituloPagina" Text="CONTROLE DE VENCIMENTOS, MULTAS, JUROS E BAIXAS DE PAGAMENTOS" FontSize="11" Foreground="#00AA44"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnIncluir" Content="[+] INCLUIR TITULO (F2)" Click="BtnIncluir_Click"
                        Style="{StaticResource PrimaryTerminalButtonStyle}" Height="34" Width="220"/>
            </Grid>
        </Border>

        <!-- BARRA DE FILTROS -->
        <Border Grid.Row="1" BorderBrush="#004411" BorderThickness="1" Background="#030A03" Padding="10" Margin="0,0,0,8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="CONTA CORRENTE:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <ComboBox x:Name="CboFiltroConta" HorizontalAlignment="Stretch" Height="32" SelectionChanged="Filtro_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="SITUACAO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <ComboBox x:Name="CboFiltroStatus" HorizontalAlignment="Stretch" Height="32" SelectionChanged="Filtro_SelectionChanged">
                        <ComboBoxItem Content="Todos" Tag="TODOS" IsSelected="True"/>
                        <ComboBoxItem Content="Em Aberto" Tag="ABERTOS"/>
                        <ComboBoxItem Content="Vencidos" Tag="VENCIDOS"/>
                        <ComboBoxItem Content="Quitados (Pagos/Rec.)" Tag="QUITADOS"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="VENCIMENTO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <ComboBox x:Name="CboFiltroPeriodo" HorizontalAlignment="Stretch" Height="32" SelectionChanged="CboFiltroPeriodo_SelectionChanged">
                        <ComboBoxItem Content="Hoje" Tag="HOJE"/>
                        <ComboBoxItem Content="Essa Semana" Tag="SEMANA"/>
                        <ComboBoxItem Content="Esse Mes" Tag="MES" IsSelected="True"/>
                        <ComboBoxItem Content="Personalizado" Tag="PERSONALIZADO"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Spacing="3">
                    <TextBlock Text="VENC. INICIAL:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <TextBox x:Name="TxtDataInicio" MaxLength="10" PlaceholderText="dd/mm/aaaa" Height="32" IsEnabled="False"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Spacing="3">
                    <TextBlock Text="VENC. FINAL:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <TextBox x:Name="TxtDataFim" MaxLength="10" PlaceholderText="dd/mm/aaaa" Height="32" IsEnabled="False"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Spacing="3">
                    <TextBlock Text="BUSCAR (DESCRICAO / DOC / ENTIDADE):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <TextBox x:Name="TxtBusca" PlaceholderText="Digite para filtrar..." Height="32" TextChanged="TxtBusca_TextChanged"/>
                </StackPanel>

                <Button Grid.Column="6" x:Name="BtnFiltrar" Content="[F3] FILTRAR" Click="BtnFiltrar_Click"
                        VerticalAlignment="Bottom" Height="32" Width="105"/>
            </Grid>
        </Border>

        <!-- GRID DE TÍTULOS -->
        <Border Grid.Row="2" BorderBrush="#004411" BorderThickness="1" Background="#020802">
            <ListView x:Name="ListaContasPR" SelectionMode="Single"
                      DoubleTapped="ListaContasPR_DoubleTapped"
                      KeyDown="ListaContasPR_KeyDown">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Background="#051A05" Padding="10,8" BorderBrush="#008833" BorderThickness="0,0,0,1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="136"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VENCIMENTO" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="PARC." Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="DESCRICAO" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="DOCUMENTO" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="4" Text="ENTIDADE" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="5" Text="CATEGORIA" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="6" Text="VALOR" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="7" Text="ENCARGOS" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="8" Text="VALOR PAGO" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="9" Text="DATA PAGTO" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="10" Text="STATUS" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="11" Text="ACOES" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ContaPR">
                        <Grid Padding="10,7" BorderBrush="#00280A" BorderThickness="0,0,0,1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="136"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind DataVencimentoFormatada}" Foreground="#00FF66" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ParcelaFormatada}" Foreground="#3399FF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Descricao}" Foreground="#00FF66" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind NumeroDocumentoFormatado}" Foreground="#88CC99" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind NumeroDocumentoFormatado}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind NomeEntidade}" Foreground="#55CC77" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind NomeCategoria}" Foreground="#00AA44" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="6" Text="{x:Bind ValorFormatado}" Foreground="{x:Bind ValorCor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="{x:Bind EncargosFormatado}" Foreground="#FFAA00" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="{x:Bind ValorPagoFormatado}" Foreground="#00FF66" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="{x:Bind DataPagamentoFormatada}" Foreground="#00AA44" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="10" Text="{x:Bind StatusTexto}" Foreground="{x:Bind StatusCor}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="11" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button
                                    Content="EDITAR"
                                    Tag="{x:Bind}"
                                    Background="#112233"
                                    Foreground="#3399FF"
                                    BorderBrush="#3399FF"
                                    BorderThickness="1"
                                    Padding="7,3"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Click="BtnEditarLinha_Click"/>

                                <Button
                                    Content="BAIXAR"
                                    Tag="{x:Bind}"
                                    Background="#003319"
                                    Foreground="#00FF66"
                                    BorderBrush="#00FF66"
                                    BorderThickness="1"
                                    Padding="7,3"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Click="BtnBaixarLinha_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- RODAPÉ COM TOTAIS -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="&gt; [F2]: INCLUIR | [DUPLO CLIQUE / ENTER]: EDITAR | [DEL]: EXCLUIR" FontSize="11" Foreground="#00AA44"/>
                <TextBlock x:Name="TxtTotalRegistros" Text="REGISTROS: 0" FontSize="11" Foreground="#00FF66" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Border BorderBrush="#006622" BorderThickness="1" Background="#041004" Padding="12,6">
                    <TextBlock x:Name="TxtTotalEmAberto" Text="Em Aberto: R$ 0,00" FontSize="13" FontWeight="Bold" Foreground="#FFAA00"/>
                </Border>

                <Border BorderBrush="#00FF66" BorderThickness="1" Background="#051805" Padding="14,6">
                    <TextBlock x:Name="TxtTotalQuitado" Text="Total Pago: R$ 0,00" FontSize="14" FontWeight="Bold" Foreground="#00FF66"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>