<Page
    x:Class="ContaMobi.Views.CartoesCreditoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ContaMobi.Models"
    mc:Ignorable="d">

    <Grid Background="#000000" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" BorderBrush="#00FF66" BorderThickness="1" Background="#051005" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="[ CARTOES DE CREDITO // CADASTRO E LIMITES ]" FontSize="16" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="GESTAO DE CARTOES, BANDEIRAS, CICLOS DE FECHAMENTO E LIMITES DISPONIVEIS" FontSize="11" Foreground="#00AA44"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnIncluir" Content="[+] INCLUIR CARTAO (F2)" Click="BtnIncluir_Click"
                        Style="{StaticResource PrimaryTerminalButtonStyle}" Height="34" Width="220"/>
            </Grid>
        </Border>

        <!-- BARRA DE FILTROS -->
        <Border Grid.Row="1" BorderBrush="#004411" BorderThickness="1" Background="#030A03" Padding="10" Margin="0,0,0,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="SITUACAO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <ComboBox x:Name="CboFiltroStatus" HorizontalAlignment="Stretch" Height="32" SelectionChanged="CboFiltroStatus_SelectionChanged">
                        <ComboBoxItem Content="Todos" Tag="TODOS" IsSelected="True"/>
                        <ComboBoxItem Content="Ativos" Tag="ATIVOS"/>
                        <ComboBoxItem Content="Inativos" Tag="INATIVOS"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="BUSCAR (NOME DO CARTAO / BANDEIRA / FINAL / CONTA):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                    <TextBox x:Name="TxtBusca" PlaceholderText="Digite para filtrar..." Height="32" TextChanged="TxtBusca_TextChanged"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="BtnFiltrar" Content="[F3] FILTRAR" Click="BtnFiltrar_Click"
                        VerticalAlignment="Bottom" Height="32" Width="110"/>
            </Grid>
        </Border>

        <!-- GRID DE CARTÕES -->
        <Border Grid.Row="2" BorderBrush="#004411" BorderThickness="1" Background="#020802">
            <ListView x:Name="ListaCartoes" SelectionMode="Single"
                      DoubleTapped="ListaCartoes_DoubleTapped"
                      KeyDown="ListaCartoes_KeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Background="#051A05" Padding="10,8" BorderBrush="#008833" BorderThickness="0,0,0,1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COR" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="DESCRICAO DO CARTAO" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="BANDEIRA" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="CONTA DEBITO" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="4" Text="CICLO FATURA" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="5" Text="LIMITE TOTAL" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="UTILIZADO" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="7" Text="DISPONIVEL" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="8" Text="STATUS" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="ACOES" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CartaoCredito">
                        <Grid Padding="10,8" BorderBrush="#00280A" BorderThickness="0,0,0,1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <!-- INDICADOR VISUAL DE COR DO CARTÃO -->
                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="3"
                                    Background="{x:Bind CorHex}" BorderBrush="#FFFFFF" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" Text="{x:Bind NomeExibicao}" Foreground="#00FF66" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind NomeBandeira}" Foreground="#55CC77" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind ContaCorrente.Descricao, FallbackValue='-'}" Foreground="#88CC99" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind CicloFormatado}" Foreground="#00AA44" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind LimiteTotalFormatado}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{x:Bind LimiteUtilizadoFormatado}" Foreground="#FFAA00" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="{x:Bind LimiteAtualFormatado}" Foreground="{x:Bind LimiteAtualCor}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="{x:Bind StatusTexto}" Foreground="{x:Bind StatusCor}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button
                                    Content="EDITAR"
                                    Tag="{x:Bind}"
                                    Background="#112233"
                                    Foreground="#3399FF"
                                    BorderBrush="#3399FF"
                                    BorderThickness="1"
                                    Padding="7,3"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Click="BtnEditarLinha_Click"/>

                                <Button
                                    Content="EXCLUIR"
                                    Tag="{x:Bind}"
                                    Background="#330000"
                                    Foreground="#FF5555"
                                    BorderBrush="#FF5555"
                                    BorderThickness="1"
                                    Padding="7,3"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Click="BtnExcluirLinha_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- RODAPÉ COM CONSOLIDADO DE LIMITES (CARTOES ATIVOS) -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="&gt; [F2]: INCLUIR CARTAO | [DUPLO CLIQUE / ENTER]: EDITAR | [DEL]: EXCLUIR" FontSize="11" Foreground="#00AA44"/>
                <TextBlock x:Name="TxtTotalRegistros" Text="CARTOES: 0" FontSize="11" Foreground="#00FF66" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Border BorderBrush="#006622" BorderThickness="1" Background="#041004" Padding="12,6">
                    <TextBlock x:Name="TxtLimiteTotalGeral" Text="Limite Total: R$ 0,00" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0"/>
                </Border>

                <Border BorderBrush="#006622" BorderThickness="1" Background="#041004" Padding="12,6">
                    <TextBlock x:Name="TxtLimiteUtilizadoGeral" Text="Utilizado: R$ 0,00" FontSize="13" FontWeight="Bold" Foreground="#FFAA00"/>
                </Border>

                <Border BorderBrush="#00FF66" BorderThickness="1" Background="#051805" Padding="14,6">
                    <TextBlock x:Name="TxtLimiteDisponivelGeral" Text="Disponivel: R$ 0,00" FontSize="14" FontWeight="Bold" Foreground="#00FF66"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>