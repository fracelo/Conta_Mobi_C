<Window
    x:Class="ContaMobi.Views.BandeiraEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ContaMobi.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CONTA MOBI // EDICAO DE BANDEIRA">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Border BorderBrush="#00FF66" BorderThickness="1" Padding="20" VerticalAlignment="Center">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TxtTitulo" Text="[ CADASTRO / EDICAO DE BANDEIRA ]" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="------------------------------------------------" FontSize="11" Foreground="#006622"/>
                </StackPanel>

                <TextBlock x:Name="TxtMensagem" FontSize="12" Foreground="#FF5555" TextWrapping="Wrap" Visibility="Collapsed"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="DESCRICAO DA BANDEIRA:" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtDescricao" PlaceholderText="Ex: Visa, Mastercard, Elo, Nubank..." Height="36" MaxLength="80"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="ICONE DA BANDEIRA:" FontSize="11" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="64" Height="42" CornerRadius="4"
                                Background="#FFFFFF" BorderBrush="#008833" BorderThickness="1" Padding="4">
                            <Image x:Name="ImgPreview" Stretch="Uniform"/>
                        </Border>

                        <Button x:Name="BtnSelecionarImagem" Content="[SELECIONAR IMAGEM...]"
                                Click="BtnSelecionarImagem_Click" Height="36" Padding="14,0"/>
                    </StackPanel>

                    <TextBlock Text="&gt; Formato: PNG (fundo transparente), JPG ou WEBP."
                               FontSize="11" Foreground="#00AA44" Margin="0,2,0,0"/>
                    <TextBlock Text="&gt; Tamanho ideal: 128 x 80 px (horizontal 3:2) ou 128 x 128 px (quadrado)."
                               FontSize="11" Foreground="#00AA44"/>
                </StackPanel>

                <CheckBox x:Name="ChkAtivo" Content="Bandeira Ativa" IsChecked="True" FontFamily="Consolas" Foreground="#00FF66"/>

                <TextBlock Text="------------------------------------------------" FontSize="11" Foreground="#006622"/>

                <Grid ColumnSpacing="10" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnCancelar" Grid.Column="0" Content="RESTAURAR" Click="BtnCancelar_Click" HorizontalAlignment="Stretch" Height="36"/>
                    <Button x:Name="BtnExcluir" Grid.Column="1" Content="EXCLUIR" Click="BtnExcluir_Click" Foreground="#FF5555" HorizontalAlignment="Stretch" Height="36"/>
                    <Button x:Name="BtnSalvar" Grid.Column="2" Content="[F2] SALVAR" Click="BtnSalvar_Click" Style="{StaticResource PrimaryTerminalButtonStyle}" HorizontalAlignment="Stretch" Height="36"/>
                    <Button x:Name="BtnSair" Grid.Column="3" Content="SAIR" Click="BtnSair_Click" HorizontalAlignment="Stretch" Height="36"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>