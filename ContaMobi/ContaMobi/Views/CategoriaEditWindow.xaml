<Window
    x:Class="ContaMobi.Views.CategoriaEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CONTA MOBI // CATEGORIA">

    <Grid Background="#000000" Padding="16">
        <Border BorderBrush="#00FF66" BorderThickness="1" Background="#030A03" Padding="16">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock x:Name="TxtTitulo" Text="[ NOVA CATEGORIA // PLANO DE CONTAS ]" FontSize="14" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="--------------------------------------------------------------------------------" FontSize="11" Foreground="#006622"/>
                </StackPanel>

                <!-- MENSAGEM DE ERRO / CONFIRMAÇÃO -->
                <TextBlock Grid.Row="1" x:Name="TxtMensagem" FontSize="11" Foreground="#FF5555" TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- CAMPOS DO FORMULÁRIO -->
                <StackPanel Grid.Row="2" Spacing="14">

                    <!-- 1. SELEÇÃO DO TIPO (D OU C) -->
                    <Border BorderBrush="#005522" BorderThickness="1" Background="#051405" Padding="12,8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="1. TIPO DA CATEGORIA (D OU C) (*):" FontSize="10" FontWeight="Bold" Foreground="#00FF66"/>
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton x:Name="RbDespesa" Content="D - DESPESA (SAIDA)" IsChecked="True"
                                             Checked="RbTipo_Changed" Foreground="#FF5555" FontWeight="SemiBold"/>
                                <RadioButton x:Name="RbReceita" Content="C - RECEITA (ENTRADA)"
                                             Checked="RbTipo_Changed" Foreground="#3399FF" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. COMBO DE CATEGORIAS DE NÍVEL 1 (POR PADRÃO VAZIO) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="2. CATEGORIA DE 1º NIVEL / GRUPO PAI (DEIXE VAZIO PARA CRIAR 1º NIVEL):"
                                   FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" x:Name="CboCategoriaPai"
                                      HorizontalAlignment="Stretch" Height="36"
                                      IsTextSearchEnabled="True"
                                      PlaceholderText="(Vazio = Nova categoria sera de 1º Nivel / Pai)"
                                      SelectionChanged="CboCategoriaPai_SelectionChanged"/>

                            <Button Grid.Column="1" x:Name="BtnLimparPai" Content="[DEIXAR VAZIO]"
                                    Click="BtnLimparPai_Click" Height="36" Padding="10,0" FontSize="10"/>
                        </Grid>
                    </StackPanel>

                    <!-- 3. INFORMAÇÃO DE NÍVEL + CAMPO PARA DIGITAR A NOVA CATEGORIA -->
                    <StackPanel Spacing="6">
                        <Border BorderBrush="#008833" BorderThickness="1" Background="#041204" Padding="10,8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="INFO: Combo vazio = Categoria Nivel 1 (Pai) | Combo selecionado = Categoria Nivel 2 (Aceita Lancamento)"
                                           FontSize="10" Foreground="#00AA44" TextWrapping="Wrap"/>
                                <TextBlock x:Name="LblInfoNivel"
                                           Text="&gt; STATUS ATUAL: COMBO VAZIO -&gt; SERA GRAVADA COMO NIVEL 1 (GRUPO PAI)"
                                           FontSize="11" FontWeight="Bold" Foreground="#FFAA00" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="3. DESCRICAO DA NOVA CATEGORIA (*):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66" Margin="0,4,0,0"/>
                        <TextBox x:Name="TxtDescricao" PlaceholderText="Digite o nome da categoria..." Height="36"
                                 KeyDown="TxtDescricao_KeyDown"/>
                    </StackPanel>
                </StackPanel>

                <!-- BOTÕES DE AÇÃO -->
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSalvar" Content="[F10] SALVAR / INCLUIR" Click="BtnSalvar_Click"
                            Style="{StaticResource PrimaryTerminalButtonStyle}" Height="38" HorizontalAlignment="Stretch"/>

                    <Button Grid.Column="1" x:Name="BtnCancelar" Content="[ESC] FECHAR" Click="BtnCancelar_Click"
                            Height="38" HorizontalAlignment="Stretch"/>

                    <Button Grid.Column="2" x:Name="BtnExcluir" Content="[DEL] EXCLUIR" Click="BtnExcluir_Click"
                            Background="#330000" Foreground="#FF5555" BorderBrush="#880000" Height="38" Width="110" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>