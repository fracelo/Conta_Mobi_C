<Window
    x:Class="ContaMobi.Views.TransferenciaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Transferência entre Contas - Conta Mobi">

    <Grid Background="#0A0E14" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. CABEÇALHO -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock
                Text="[ TRANSFERÊNCIA ENTRE CONTAS ]"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#3399FF" />
            <TextBlock
                Text="Lançamento interno neutro (não entra no Orçamento nem nos Relatórios de Receitas/Despesas)"
                FontSize="11"
                Foreground="#8899AA" />
        </StackPanel>

        <!-- 2. CONTAS ORIGEM E DESTINO -->
        <Border
            Grid.Row="1"
            Background="#111820"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,12">
            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="CONTA DE ORIGEM (SAÍDA / DÉBITO) (*):" FontSize="11" FontWeight="Bold" Foreground="#FF5555" />
                    <ComboBox
                        x:Name="CboContaOrigem"
                        HorizontalAlignment="Stretch"
                        Background="#0A0E14"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        DisplayMemberPath="Descricao"
                        SelectedValuePath="ContaUuid"
                        PlaceholderText="Selecione a conta de origem..." />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="CONTA DE DESTINO (ENTRADA / CRÉDITO) (*):" FontSize="11" FontWeight="Bold" Foreground="#00FF66" />
                    <ComboBox
                        x:Name="CboContaDestino"
                        HorizontalAlignment="Stretch"
                        Background="#0A0E14"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        DisplayMemberPath="Descricao"
                        SelectedValuePath="ContaUuid"
                        PlaceholderText="Selecione a conta de destino..." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. DATA E VALOR -->
        <Border
            Grid.Row="2"
            Background="#111820"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,12">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="DATA (*):" FontSize="11" FontWeight="Bold" Foreground="#00FF66" />
                    <TextBox
                        x:Name="TxtData"
                        PlaceholderText="dd/mm/aaaa"
                        MaxLength="10"
                        Background="#0A0E14"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        TextChanged="TxtData_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="VALOR DA TRANSFERÊNCIA (R$) (*):" FontSize="11" FontWeight="Bold" Foreground="#3399FF" />
                    <TextBox
                        x:Name="TxtValor"
                        Text="0,00"
                        FontSize="16"
                        FontWeight="Bold"
                        TextAlignment="Right"
                        Background="#0A0E14"
                        Foreground="#3399FF"
                        BorderBrush="#3399FF"
                        TextChanged="TxtValor_TextChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. OBSERVAÇÃO E CONCILIAÇÃO -->
        <Border
            Grid.Row="3"
            Background="#111820"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,12">
            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="OBSERVAÇÃO / HISTÓRICO (OPCIONAL):" FontSize="11" FontWeight="Bold" Foreground="#8899AA" />
                    <TextBox
                        x:Name="TxtObservacao"
                        PlaceholderText="Ex: PIX para reserva, cobertura de saldo..."
                        MaxLength="200"
                        Background="#0A0E14"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155" />
                </StackPanel>

                <CheckBox
                    x:Name="ChkConciliado"
                    Content="Marcar ambos os lançamentos como conciliados"
                    IsChecked="True"
                    Foreground="#CBD5E1" />
            </StackPanel>
        </Border>

        <!-- 5. MENSAGEM DE VALIDAÇÃO -->
        <TextBlock
            x:Name="TxtMensagem"
            Grid.Row="4"
            Visibility="Collapsed"
            FontWeight="Bold"
            TextWrapping="Wrap"
            VerticalAlignment="Center" />

        <!-- 6. BOTÕES -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button
                x:Name="BtnTransferir"
                Content="[CONFIRMAR TRANSFERÊNCIA]"
                Background="#0F2438"
                Foreground="#3399FF"
                BorderBrush="#3399FF"
                BorderThickness="1"
                Padding="20,9"
                FontWeight="Bold"
                Click="BtnTransferir_Click" />

            <Button
                Content="[CANCELAR]"
                Background="#1E293B"
                Foreground="#E2E8F0"
                BorderBrush="#475569"
                BorderThickness="1"
                Padding="16,9"
                Click="BtnCancelar_Click" />
        </StackPanel>
    </Grid>
</Window>