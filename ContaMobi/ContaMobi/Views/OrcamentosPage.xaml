<Page
    x:Class="ContaMobi.Views.OrcamentosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ContaMobi.Models"
    Background="#0A0E14"
    FontFamily="Consolas">

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- CABEÇALHO E BOTÃO DE INCLUSÃO -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock
                    Text="[ GESTÃO DE ORÇAMENTO ANUAL // 12 MESES ]"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#00FF66" />
                <TextBlock
                    Text="Projeção em cascata: qualquer alteração em um mês recalcula automaticamente todos os meses seguintes."
                    FontSize="12"
                    Foreground="#8899AA" />
            </StackPanel>

            <Button
                x:Name="BtnIncluirOrcamento"
                Grid.Column="1"
                Content="[+ INCLUIR ORÇAMENTO]"
                Background="#003319"
                Foreground="#00FF66"
                BorderBrush="#00FF66"
                BorderThickness="1"
                Padding="16,8"
                FontWeight="Bold"
                Click="BtnIncluirOrcamento_Click" />
        </Grid>

        <!-- BARRA SUPERIOR DE FILTROS E BUSCA -->
        <Border
            Grid.Row="1"
            Background="#111820"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="MÊS INICIAL:" FontSize="11" Foreground="#8899AA" />
                    <ComboBox
                        x:Name="CboMesInicial"
                        HorizontalAlignment="Stretch"
                        Background="#0A0E14"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        SelectionChanged="FiltroPeriodo_Changed">
                        <ComboBoxItem Content="01 - JANEIRO" Tag="1" />
                        <ComboBoxItem Content="02 - FEVEREIRO" Tag="2" />
                        <ComboBoxItem Content="03 - MARÇO" Tag="3" />
                        <ComboBoxItem Content="04 - ABRIL" Tag="4" />
                        <ComboBoxItem Content="05 - MAIO" Tag="5" />
                        <ComboBoxItem Content="06 - JUNHO" Tag="6" />
                        <ComboBoxItem Content="07 - JULHO" Tag="7" />
                        <ComboBoxItem Content="08 - AGOSTO" Tag="8" />
                        <ComboBoxItem Content="09 - SETEMBRO" Tag="9" />
                        <ComboBoxItem Content="10 - OUTUBRO" Tag="10" />
                        <ComboBoxItem Content="11 - NOVEMBRO" Tag="11" />
                        <ComboBoxItem Content="12 - DEZEMBRO" Tag="12" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="ANO INICIAL:" FontSize="11" Foreground="#8899AA" />
                    <TextBox
                        x:Name="TxtAnoInicial"
                        MaxLength="4"
                        Background="#0A0E14"
                        Foreground="#00FF66"
                        BorderBrush="#334155"
                        LostFocus="TxtAnoInicial_LostFocus"
                        TextChanged="TxtAnoInicial_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="BUSCAR MÊS / ANO / STATUS:" FontSize="11" Foreground="#8899AA" />
                    <TextBox
                        x:Name="TxtBusca"
                        PlaceholderText="Digite ex: 11/2026, NOVEMBRO, ATIVO..."
                        Background="#0A0E14"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        TextChanged="TxtBusca_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                    <Button
                        Content="[EXPORTAR CSV]"
                        Background="#16222F"
                        Foreground="#FFCC00"
                        BorderBrush="#FFCC00"
                        BorderThickness="1"
                        Click="BtnExportarCsv_Click" />
                    <Button
                        Content="[HOJE + 11M]"
                        Background="#1E293B"
                        Foreground="#3399FF"
                        BorderBrush="#3399FF"
                        BorderThickness="1"
                        Click="BtnPeriodoAtual_Click" />
                    <Button
                        Content="[ATUALIZAR]"
                        Background="#1E293B"
                        Foreground="#00FF66"
                        BorderBrush="#00FF66"
                        BorderThickness="1"
                        Click="BtnAtualizar_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABELA DOS 12 ORÇAMENTOS -->
        <Border
            Grid.Row="2"
            Background="#111820"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Background="#16202C"
                    BorderBrush="#1E293B"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="MÊS / ANO" FontWeight="Bold" Foreground="#00FF66" />
                        <TextBlock Grid.Column="1" Text="STATUS" FontWeight="Bold" Foreground="#8899AA" />
                        <TextBlock Grid.Column="2" Text="SALDO ANTERIOR" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="TOTAL CRÉDITOS (+)" FontWeight="Bold" Foreground="#3399FF" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="TOTAL DÉBITOS (-)" FontWeight="Bold" Foreground="#FF5555" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="SALDO FINAL (=)" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="AÇÃO" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <ListView
                    x:Name="ListaOrcamentos"
                    Grid.Row="1"
                    SelectionMode="Single"
                    DoubleTapped="ListaOrcamentos_DoubleTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:OrcamentoMesResumo">
                            <Border
                                Background="#0D131A"
                                BorderBrush="#1E293B"
                                BorderThickness="0,0,0,1"
                                Padding="14,10">
                                <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind MesAnoFormatado}"
                                        FontWeight="Bold"
                                        Foreground="#E2E8F0"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind StatusTag}"
                                        Foreground="{x:Bind CorStatus}"
                                        FontSize="12"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind SaldoAnteriorFormatado}"
                                        Foreground="{x:Bind CorSaldoAnterior}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind TotalCreditosFormatado}"
                                        Foreground="#3399FF"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{x:Bind TotalDebitosFormatado}"
                                        Foreground="#FF5555"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{x:Bind SaldoFinalFormatado}"
                                        Foreground="{x:Bind CorSaldoFinal}"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />

                                    <Button
                                        Grid.Column="6"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Center"
                                        Background="#16222F"
                                        Foreground="#00FF66"
                                        BorderBrush="#00FF66"
                                        BorderThickness="1"
                                        Padding="10,4"
                                        ToolTipService.ToolTip="Editar orçamento deste mês"
                                        Click="BtnEditarLinha_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                            <TextBlock Text="EDITAR" FontSize="11" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- RODAPÉ DE TOTAIS ACUMULADOS DOS 12 MESES -->
        <Border
            Grid.Row="3"
            Background="#16202C"
            BorderBrush="#00FF66"
            BorderThickness="1"
            CornerRadius="4"
            Padding="16,10">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="TxtResumoPeriodo"
                    Grid.Column="0"
                    Text="ACUMULADO 12 MESES:"
                    FontWeight="Bold"
                    Foreground="#00FF66"
                    VerticalAlignment="Center" />

                <TextBlock
                    x:Name="TxtSomaCreditos12M"
                    Grid.Column="2"
                    Text="Créditos 12M: R$ 0,00"
                    Foreground="#3399FF"
                    FontWeight="Bold"
                    VerticalAlignment="Center" />

                <TextBlock
                    x:Name="TxtSomaDebitos12M"
                    Grid.Column="3"
                    Text="Débitos 12M: R$ 0,00"
                    Foreground="#FF5555"
                    FontWeight="Bold"
                    VerticalAlignment="Center" />

                <TextBlock
                    x:Name="TxtSaldoFinal12M"
                    Grid.Column="4"
                    Text="Saldo Final 12º Mês: R$ 0,00"
                    Foreground="#00FF66"
                    FontWeight="Bold"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>