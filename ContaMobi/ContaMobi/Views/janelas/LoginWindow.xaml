<Window
    x:Class="ContaMobi.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CONTA MOBI // AUTENTICACAO">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <Border BorderBrush="#00FF66" BorderThickness="1" Padding="24" VerticalAlignment="Center" MaxWidth="380">
            <StackPanel Spacing="14">

                <!-- CABEÇALHO RETRÔ -->
                <StackPanel Spacing="3">
                    <TextBlock Text="[ CONTA MOBI // TERMINAL ]" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#00FF66"/>
                    <TextBlock x:Name="TxtSubtitulo" Text="&gt; AUTENTICACAO DE USUARIO" FontSize="11" Foreground="#00AA44" HorizontalAlignment="Center"/>
                    <TextBlock Text="----------------------------------------" FontSize="11" Foreground="#006622" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- MENSAGEM DINÂMICA DE ERRO OU SUCESSO -->
                <TextBlock x:Name="TxtErro" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" HorizontalAlignment="Center"/>

                <!-- ========================================== -->
                <!-- PAINEL 1: LOGIN (PADRÃO VISÍVEL)          -->
                <!-- ========================================== -->
                <StackPanel x:Name="PainelLogin" Spacing="12" Visibility="Visible">
                    <!-- E-MAIL -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="USUARIO / E-MAIL:" FontSize="11" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <TextBox x:Name="TxtEmail" PlaceholderText="seu@email.com" Height="36"/>
                    </StackPanel>

                    <!-- SENHA -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="CHAVE DE ACESSO (SENHA):" FontSize="11" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <PasswordBox x:Name="TxtSenha" PlaceholderText="********" Height="36" KeyDown="TxtSenha_KeyDown"/>
                    </StackPanel>

                    <TextBlock Text="----------------------------------------" FontSize="11" Foreground="#006622"/>

                    <!-- BOTÕES PRINCIPAIS -->
                    <StackPanel Spacing="8">
                        <Button x:Name="BtnLogin" Content="[ENTER] LOGIN" Click="BtnLogin_Click"
                                Style="{StaticResource PrimaryTerminalButtonStyle}" Height="38" HorizontalAlignment="Stretch"/>
                        <Button x:Name="BtnCancelar" Content="[ESC] FECHAR" Click="BtnCancelar_Click"
                                Height="34" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- LINK / BOTÃO ESQUECI MINHA SENHA (APÓS OS BOTÕES PRINCIPAIS) -->
                    <Button x:Name="BtnEsqueciSenha" Content="&gt; [Esqueci minha senha / Recuperar]" 
                            Click="BtnEsqueciSenha_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#00AA44"
                            FontSize="11" Padding="0" Margin="0,2,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- ========================================== -->
                <!-- PAINEL 2: RECUPERAÇÃO DE SENHA             -->
                <!-- ========================================== -->
                <StackPanel x:Name="PainelRecuperacao" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Digite o codigo enviado por e-mail e sua nova senha:" 
                               FontSize="11" Foreground="#00AA44" TextWrapping="Wrap"/>

                    <!-- CÓDIGO TOKEN -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="CODIGO DE CONFIRMACAO:" FontSize="11" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <TextBox x:Name="TxtCodigoToken" PlaceholderText="Ex: 123456" Height="36" MaxLength="20"/>
                    </StackPanel>

                    <!-- NOVA SENHA -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="NOVA SENHA:" FontSize="11" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <PasswordBox x:Name="TxtNovaSenha" PlaceholderText="Minimo 6 digitos" Height="36"/>
                    </StackPanel>

                    <!-- CONFIRMAR SENHA -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="CONFIRME A NOVA SENHA:" FontSize="11" FontWeight="SemiBold" Foreground="#00FF66"/>
                        <PasswordBox x:Name="TxtConfirmarSenha" PlaceholderText="Repita a nova senha" Height="36"/>
                    </StackPanel>

                    <TextBlock Text="----------------------------------------" FontSize="11" Foreground="#006622"/>

                    <!-- BOTÕES DE RECUPERAÇÃO -->
                    <StackPanel Spacing="8">
                        <Button x:Name="BtnSalvarNovaSenha" Content="[GRAVAR SENHA]" Click="BtnSalvarNovaSenha_Click"
                                Style="{StaticResource PrimaryTerminalButtonStyle}" Height="38" HorizontalAlignment="Stretch"/>
                        <Button x:Name="BtnVoltarLogin" Content="&lt; VOLTAR AO LOGIN" Click="BtnVoltarLogin_Click"
                                Height="34" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>