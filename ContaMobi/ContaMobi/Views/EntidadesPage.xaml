<Page
    x:Class="ContaMobi.Views.EntidadesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ContaMobi.Models"
    mc:Ignorable="d">

    <Grid Background="#000000" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" BorderBrush="#00FF66" BorderThickness="1" Background="#051005" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="[ CADASTRO // ENTIDADES (FAVORECIDOS) ]" FontSize="16" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="CLIENTES, FORNECEDORES, PARCEIROS, FUNCIONARIOS E CONTATOS (PF/PJ)" FontSize="11" Foreground="#00AA44"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnInserir" Content="[+] NOVA ENTIDADE (F2)" Click="BtnInserir_Click"
                        Style="{StaticResource PrimaryTerminalButtonStyle}" Height="34" Width="200"/>
            </Grid>
        </Border>

        <!-- FILTROS -->
        <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtBusca" Grid.Column="0" PlaceholderText="BUSCAR POR NOME, RAZAO SOCIAL, CPF OU CNPJ..." 
                     Height="34" TextChanged="TxtBusca_TextChanged" KeyDown="TxtBusca_KeyDown"/>

            <ComboBox x:Name="CboFiltroTipoEntidade" Grid.Column="1" HorizontalAlignment="Stretch" Height="34" 
                      SelectionChanged="CboFiltro_SelectionChanged">
                <ComboBoxItem Content="TODAS ENTIDADES" IsSelected="True" Tag=""/>
                <ComboBoxItem Content="CLIENTE" Tag="Cliente"/>
                <ComboBoxItem Content="FORNECEDOR" Tag="Fornecedor"/>
                <ComboBoxItem Content="PARCEIRO" Tag="Parceiro"/>
                <ComboBoxItem Content="FUNCIONARIO" Tag="Funcionario"/>
                <ComboBoxItem Content="OUTROS" Tag="Outros"/>
            </ComboBox>

            <ComboBox x:Name="CboFiltroPessoa" Grid.Column="2" HorizontalAlignment="Stretch" Height="34" 
                      SelectionChanged="CboFiltro_SelectionChanged">
                <ComboBoxItem Content="PF / PJ" IsSelected="True" Tag=""/>
                <ComboBoxItem Content="PESSOA FISICA" Tag="F"/>
                <ComboBoxItem Content="PESSOA JURIDICA" Tag="J"/>
            </ComboBox>

            <Button Grid.Column="3" x:Name="BtnBuscar" Content="[F3] FILTRAR" Click="BtnBuscar_Click" 
                    Height="34" Width="110"/>
        </Grid>

        <!-- LISTA TABULAR COM CABEÇALHO -->
        <Border Grid.Row="2" BorderBrush="#004411" BorderThickness="1" Background="#020802">
            <ListView x:Name="ListaEntidades" DoubleTapped="ListaEntidades_DoubleTapped" 
                      KeyDown="ListaEntidades_KeyDown" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Background="#051A05" Padding="10,8" BorderBrush="#008833" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="NOME / RAZAO SOCIAL" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="CLASSIFICACAO" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="TIPO" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="CPF / CNPJ" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="4" Text="CIDADE / UF" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="5" Text="ACOES" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Entidade">
                        <Grid Padding="10,6" BorderBrush="#003311" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind NomeRazao}" Foreground="#00FF66" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind TipoEntidadeBadge}" Foreground="#55CC77" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind TipoPessoaDescricao}" Foreground="#00AA44" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind DocumentoFormatado}" Foreground="#00FF66" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind CidadeUfFormatada}" Foreground="#00AA44" FontSize="11" VerticalAlignment="Center"/>
                            <Button Grid.Column="5"
                                    Content="[EDITAR]"
                                    Click="BtnEditarLinha_Click"
                                    Tag="{x:Bind}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Height="28"
                                    Padding="10,0"
                                    FontSize="11"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- RODAPÉ -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&gt; [EDITAR] / [ENTER] / [DUPLO CLIQUE]: EDITAR | [F2]: NOVA ENTIDADE" FontSize="11" Foreground="#00AA44"/>
                <TextBlock Grid.Column="1" x:Name="TxtTotalRegistros" Text="REGISTROS: 0" FontSize="11" Foreground="#00FF66" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Page>