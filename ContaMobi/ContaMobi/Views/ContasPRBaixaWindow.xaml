<Window
    x:Class="ContaMobi.Views.ContasPRBaixaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Baixa de Conta - Conta Mobi">

    <Grid Background="#0A0E14" Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. CABEÇALHO -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="TxtTituloModal"
                Text="[ BAIXA DE CONTA A PAGAR ]"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#00FF66"
                VerticalAlignment="Center" />

            <Border
                x:Name="BadgeParcela"
                Grid.Column="1"
                Background="#16222F"
                BorderBrush="#3399FF"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,4">
                <TextBlock
                    x:Name="TxtParcelaBadge"
                    Text="PARCELA 01/01"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#3399FF" />
            </Border>
        </Grid>

        <!-- 2. DADOS DA CONTA SELECIONADA -->
        <Border
            Grid.Row="1"
            Background="#111820"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,10">
            <Grid RowSpacing="8" ColumnSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Text="DESCRIÇÃO:" FontSize="11" Foreground="#8899AA" />
                    <TextBlock x:Name="TxtDescricao" Text="-" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                    <TextBlock Text="VENCIMENTO:" FontSize="11" Foreground="#8899AA" HorizontalAlignment="Right" />
                    <TextBlock x:Name="TxtVencimento" Text="00/00/0000" FontSize="14" FontWeight="Bold" Foreground="#FFAA00" HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                    <TextBlock Text="ENTIDADE / FAVORECIDO:" FontSize="11" Foreground="#8899AA" />
                    <TextBlock x:Name="TxtEntidade" Text="-" FontSize="13" Foreground="#CBD5E1" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <TextBlock Text="VALOR DA PARCELA:" FontSize="11" Foreground="#8899AA" HorizontalAlignment="Right" />
                    <TextBlock x:Name="TxtValorOriginal" Text="R$ 0,00" FontSize="15" FontWeight="Bold" Foreground="#00FF66" HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                    <TextBlock Text="CATEGORIA (*):" FontSize="11" FontWeight="Bold" Foreground="#00FF66" />
                    <ComboBox
                        x:Name="CboCategoria"
                        HorizontalAlignment="Stretch"
                        Background="#0A0E14"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        PlaceholderText="Selecione a categoria..." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. ENCARGOS E DESCONTOS -->
        <Border
            Grid.Row="2"
            Background="#111820"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,10">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Text="JUROS (+):" FontSize="11" FontWeight="Bold" Foreground="#FFAA00" />
                    <TextBox
                        x:Name="TxtJuros"
                        Text="0,00"
                        TextAlignment="Right"
                        Background="#0A0E14"
                        Foreground="#FFAA00"
                        BorderBrush="#334155"
                        TextChanged="TxtEncargo_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                    <TextBlock Text="MULTA (+):" FontSize="11" FontWeight="Bold" Foreground="#FFAA00" />
                    <TextBox
                        x:Name="TxtMulta"
                        Text="0,00"
                        TextAlignment="Right"
                        Background="#0A0E14"
                        Foreground="#FFAA00"
                        BorderBrush="#334155"
                        TextChanged="TxtEncargo_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                    <TextBlock Text="ACRÉSCIMOS (+):" FontSize="11" FontWeight="Bold" Foreground="#FFAA00" />
                    <TextBox
                        x:Name="TxtAcrescimo"
                        Text="0,00"
                        TextAlignment="Right"
                        Background="#0A0E14"
                        Foreground="#FFAA00"
                        BorderBrush="#334155"
                        TextChanged="TxtEncargo_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock Text="DESCONTO (-):" FontSize="11" FontWeight="Bold" Foreground="#3399FF" />
                    <TextBox
                        x:Name="TxtDesconto"
                        Text="0,00"
                        TextAlignment="Right"
                        Background="#0A0E14"
                        Foreground="#3399FF"
                        BorderBrush="#334155"
                        TextChanged="TxtEncargo_TextChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. DATA DE BAIXA E CONTA CORRENTE -->
        <Border
            Grid.Row="3"
            Background="#111820"
            BorderBrush="#1E293B"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="DATA DA BAIXA (*):" FontSize="11" FontWeight="Bold" Foreground="#00FF66" />
                    <TextBox
                        x:Name="TxtDataBaixa"
                        PlaceholderText="dd/mm/aaaa"
                        MaxLength="10"
                        Background="#0A0E14"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        TextChanged="TxtData_TextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="CONTA CORRENTE (*):" FontSize="11" FontWeight="Bold" Foreground="#00FF66" />
                    <ComboBox
                        x:Name="CboContaCorrente"
                        HorizontalAlignment="Stretch"
                        Background="#0A0E14"
                        Foreground="#E2E8F0"
                        BorderBrush="#334155"
                        DisplayMemberPath="Descricao"
                        SelectedValuePath="ContaUuid" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. TOTAL A SER BAIXADO (EDITÁVEL) -->
        <Border
            Grid.Row="4"
            Background="#0F291E"
            BorderBrush="#00FF66"
            BorderThickness="2"
            CornerRadius="4"
            Padding="14,12">
            <Grid RowSpacing="6" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Text="TOTAL A SER BAIXADO (R$):"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#00FF66" />
                    <TextBlock
                        x:Name="TxtResumoCalculado"
                        Text="Saldo calculado: R$ 0,00"
                        FontSize="11"
                        Foreground="#94A3B8" />
                </StackPanel>

                <TextBox
                    x:Name="TxtTotalBaixar"
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="0,00"
                    FontSize="18"
                    FontWeight="Bold"
                    TextAlignment="Right"
                    Background="#0A0E14"
                    Foreground="#00FF66"
                    BorderBrush="#00FF66"
                    Padding="10,6"
                    TextChanged="TxtTotalBaixar_TextChanged" />

                <TextBlock
                    x:Name="TxtAvisoDiferenca"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Visibility="Collapsed"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#FFCC00" />
            </Grid>
        </Border>

        <!-- 6. MENSAGENS DE VALIDAÇÃO -->
        <TextBlock
            x:Name="TxtMensagem"
            Grid.Row="5"
            Visibility="Collapsed"
            FontWeight="Bold"
            TextWrapping="Wrap"
            VerticalAlignment="Center" />

        <!-- 7. BOTÕES -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button
                x:Name="BtnBaixar"
                Content="[BAIXAR]"
                Background="#003319"
                Foreground="#00FF66"
                BorderBrush="#00FF66"
                BorderThickness="1"
                Padding="22,9"
                FontWeight="Bold"
                Click="BtnBaixar_Click" />

            <Button
                Content="[CANCELAR]"
                Background="#1E293B"
                Foreground="#E2E8F0"
                BorderBrush="#475569"
                BorderThickness="1"
                Padding="16,9"
                Click="BtnCancelar_Click" />
        </StackPanel>
    </Grid>
</Window>