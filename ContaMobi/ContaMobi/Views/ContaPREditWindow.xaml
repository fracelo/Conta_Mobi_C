<Window
    x:Class="ContaMobi.Views.ContaPREditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CONTA MOBI // CONTAS A PAGAR E RECEBER">

    <Grid Background="#000000" Padding="14">
        <Border BorderBrush="#00FF66" BorderThickness="1" Background="#030A03" Padding="14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TÍTULO -->
                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock x:Name="TxtTituloModal" Text="[ INCLUIR TITULO // CONTAS A PAGAR ]" FontSize="14" FontWeight="Bold" Foreground="#00FF66"/>
                    <TextBlock Text="----------------------------------------------------------------------------------------------------------------" FontSize="11" Foreground="#006622"/>
                </StackPanel>

                <!-- MENSAGEM DE ERRO / STATUS -->
                <TextBlock Grid.Row="1" x:Name="TxtMensagem" FontSize="11" Foreground="#FF5555" TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- LINHA 1: CONTA CORRENTE PREVISTA E DATA DE LANÇAMENTO -->
                <Border Grid.Row="2" BorderBrush="#005522" BorderThickness="1" Background="#051405" Padding="10,8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="CONTA CORRENTE PREVISTA PARA PAGAMENTO / RECEBIMENTO:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <ComboBox x:Name="CboContaCorrente" HorizontalAlignment="Stretch" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="DATA DE LANCAMENTO (*):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtDataLancamento" MaxLength="10" PlaceholderText="dd/mm/aaaa" Height="34"
                                     TextChanged="TxtDataLancamento_TextChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LINHA 2: CATEGORIA (COMBO) + ENTIDADE + DESCRIÇÃO + NÚMERO DOCUMENTO -->
                <Border Grid.Row="3" BorderBrush="#005522" BorderThickness="1" Background="#020802" Padding="10,8">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CATEGORIA EM COMBOBOX -->
                            <StackPanel Grid.Column="0" Spacing="3">
                                <TextBlock x:Name="LblCategoria" Text="CATEGORIA (*):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="CboCategoria"
                                              HorizontalAlignment="Stretch" Height="34"
                                              PlaceholderText="Selecione a categoria..."/>
                                    <Button Grid.Column="1" x:Name="BtnAddCategoria" Content="[+] ADD" Click="BtnAddCategoria_Click"
                                            Height="34" Padding="10,0" Style="{StaticResource PrimaryTerminalButtonStyle}"/>
                                </Grid>
                            </StackPanel>

                            <!-- ENTIDADE -->
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock x:Name="LblEntidade" Text="ENTIDADE (FORNECEDOR / CLIENTE):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <AutoSuggestBox Grid.Column="0" x:Name="AsbEntidade" PlaceholderText="Digite nome ou CPF/CNPJ..." Height="34"
                                                    DisplayMemberPath="NomeRazao" TextMemberPath="NomeRazao"
                                                    GotFocus="AsbEntidade_GotFocus"
                                                    TextChanged="AsbEntidade_TextChanged"
                                                    SuggestionChosen="AsbEntidade_SuggestionChosen"/>
                                    <Button Grid.Column="1" x:Name="BtnAddEntidade" Content="[+] ADD" Click="BtnAddEntidade_Click"
                                            Height="34" Padding="10,0" Style="{StaticResource PrimaryTerminalButtonStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- DESCRIÇÃO -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="DESCRICAO / HISTORICO DA CONTA (*):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtDescricao" PlaceholderText="Ex: Salario, Fatura Energia, Compra Fornecedor..." Height="34"/>
                        </StackPanel>

                        <!-- NÚMERO DO DOCUMENTO (OPCIONAL) -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="NUMERO DO DOCUMENTO (OPCIONAL):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtNumeroDocumento" MaxLength="35"
                                     PlaceholderText="Ex: NF 12345, BOLETO 001, DUPLICATA 10/1..." Height="34"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- LINHA 3: VALOR + OPÇÕES DE PARCELAMENTO -->
                <Border Grid.Row="4" BorderBrush="#008833" BorderThickness="1" Background="#041204" Padding="10,8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="125"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="VALOR DO LANCAMENTO (*):" FontSize="10" FontWeight="Bold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtValor" PlaceholderText="0,00" FontWeight="Bold" FontSize="14" Height="34"
                                     TextChanged="ParametroParcelas_TextChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="REGRA DE VALOR DAS PARCELAS:" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <ComboBox x:Name="CboModoParcelas" HorizontalAlignment="Stretch" Height="34"
                                      SelectionChanged="CboModoParcelas_SelectionChanged">
                                <ComboBoxItem Content="Repetir o valor em cada parcela" Tag="R" IsSelected="True"/>
                                <ComboBoxItem Content="Dividir o valor entre as parcelas" Tag="D"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="NR PARCELAS (*):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtNumeroParcelas" Text="1" MaxLength="3" Height="34"
                                     TextChanged="ParametroParcelas_TextChanged"
                                     LostFocus="TxtNumeroParcelas_LostFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="3">
                            <TextBlock Text="INTERVALO (DIAS):" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66"/>
                            <TextBox x:Name="TxtIntervaloDias" Text="30" MaxLength="4" Height="34"
                                     TextChanged="ParametroParcelas_TextChanged"
                                     LostFocus="TxtIntervaloDias_LostFocus"/>
                        </StackPanel>

                        <Button Grid.Column="4" x:Name="BtnRecalcularGrade" Content="[REGERAR GRADE]"
                                Click="BtnRecalcularGrade_Click" VerticalAlignment="Bottom" Height="34" Padding="10,0"/>
                    </Grid>
                </Border>

                <!-- LINHA 4: GRID EDITÁVEL DE VENCIMENTOS E VALORES DAS PARCELAS -->
                <Border Grid.Row="5" BorderBrush="#00FF66" BorderThickness="1" Background="#020802" Padding="8">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="GRADE DE VENCIMENTOS DAS PARCELAS (VOCE PODE EDITAR AS DATAS E VALORES ABAIXO):"
                                   FontSize="10" FontWeight="Bold" Foreground="#00FF66"/>

                        <Grid Grid.Row="1" Background="#051A05" Padding="10,6" BorderBrush="#008833" BorderThickness="0,0,0,1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PARCELA" Foreground="#00FF66" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="DATA VENCIMENTO (*)" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="VALOR DA PARCELA (R$)" Foreground="#00FF66" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="OBSERVACAO" Foreground="#00AA44" FontWeight="Bold" FontSize="11"/>
                        </Grid>

                        <ListView Grid.Row="2" x:Name="ListaParcelas" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="38"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,4" BorderBrush="#00280A" BorderThickness="0,0,0,1" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding NumeroFormatado}" Foreground="{Binding DestaqueCor}"
                                                   FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" Text="{Binding DataVencimentoTexto, Mode=TwoWay}"
                                                 Tag="{Binding}" MaxLength="10" Height="30"
                                                 PlaceholderText="dd/mm/aaaa"
                                                 TextChanged="TxtVencimentoGrid_TextChanged"/>

                                        <TextBox Grid.Column="2" Text="{Binding ValorParcelaTexto, Mode=TwoWay}"
                                                 Tag="{Binding}" Height="30" FontWeight="SemiBold"
                                                 PlaceholderText="0,00"
                                                 TextChanged="TxtValorGrid_TextChanged"/>

                                        <TextBlock Grid.Column="3" Text="Vencimento e valor editaveis antes de salvar"
                                                   Foreground="#007733" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- LINHA 5: RESUMO TOTAL DO GRID -->
                <Border Grid.Row="6" BorderBrush="#00FF66" BorderThickness="1" Background="#051805" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtResumoParcelas" Text="RESUMO DA GRADE: 1 PARCELA(S)" FontSize="11" Foreground="#00AA44" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtTotalCalculado" Text="Total das Parcelas: R$ 0,00" FontSize="15" FontWeight="Bold" Foreground="#00FF66" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- LINHA 6: BOTÕES DE AÇÃO -->
                <Grid Grid.Row="7" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnSalvar" Content="[F10] SALVAR CONTA(S)" Click="BtnSalvar_Click"
                            Style="{StaticResource PrimaryTerminalButtonStyle}" Height="38" HorizontalAlignment="Stretch"/>

                    <Button Grid.Column="1" x:Name="BtnFechar" Content="[ESC] FECHAR" Click="BtnFechar_Click"
                            Height="38" HorizontalAlignment="Stretch"/>

                    <Button Grid.Column="2" x:Name="BtnExcluir" Content="[DEL] EXCLUIR" Click="BtnExcluir_Click"
                            Background="#330000" Foreground="#FF5555" BorderBrush="#880000" Height="38" Width="120" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>